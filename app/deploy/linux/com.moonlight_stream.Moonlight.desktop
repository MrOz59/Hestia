[Desktop Entry]
Name=Hestia
Comment=Stream games and other applications from another PC running Hermes, Apollo, Sunshine or GeForce Experience
Exec=moonlight %u
Icon=moonlight
Terminal=false
Type=Application
Categories=Qt;Game;Network;RemoteAccess;
Keywords=hermes;hestia;nvidia;gamestream;stream;sunshine;remote play;
MimeType=x-scheme-handler/hestia;x-scheme-handler/moonlight;
